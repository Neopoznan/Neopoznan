# Данные приложения Telegram, получить на https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Номер телефона аккаунта, от имени которого будет работать скрипт (с кодом страны)
TG_PHONE=+79991234567

# Необязательно: пароль двухфакторной аутентификации, если включена облачная защита
TG_2FA_PASSWORD=
